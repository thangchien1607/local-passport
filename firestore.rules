rules_version = '2';

// Mỗi người chỉ đọc/ghi hộ chiếu của mình (uid từ Firebase Auth ẩn danh).
// Bài cảm nhận công khai cho mọi người đọc; chỉ chủ bài (ghi trong
// reflection_owners) được sửa hoặc xóa.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownerOf(id) {
      return get(/databases/$(database)/documents/reflection_owners/$(id)).data.uid;
    }

    function validPhotoUrl(v) {
      return v == null
        || (v is string && v.size() > 0 && v.size() <= 2048 && v.matches('^https?://.*'));
    }

    function validReflectionCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly(['locationId', 'displayAuthor', 'isAnonymous', 'content', 'createdAt', 'photoUrl'])
        && !('aiScore' in d)
        && !('photoBase64' in d)
        && d.locationId is string && d.locationId.size() > 0 && d.locationId.size() <= 80
        && d.displayAuthor is string && d.displayAuthor.size() > 0 && d.displayAuthor.size() <= 80
        && d.isAnonymous is bool
        && d.content is string && d.content.size() <= 2000
        && d.createdAt is timestamp
        && validPhotoUrl(d.get('photoUrl', null));
    }

    function validReflectionUpdate() {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return !changed.hasAny(['aiScore', 'photoBase64', 'locationId', 'createdAt'])
        && changed.hasOnly(['displayAuthor', 'isAnonymous'])
        && d.displayAuthor is string && d.displayAuthor.size() > 0 && d.displayAuthor.size() <= 80
        && d.isAnonymous is bool;
    }

    match /user_passports/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      match /visits/{locationId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && !('taskPhotos' in request.resource.data)
          && request.resource.data.keys().hasOnly(['unlocked', 'unlockedAt', 'tasks', 'taskPhotoUrls', 'stampedAt'])
          && request.resource.data.unlocked is bool
          && request.resource.data.tasks is list && request.resource.data.tasks.size() <= 30
          && request.resource.data.get('taskPhotoUrls', {}) is map
          && request.resource.data.get('taskPhotoUrls', {}).size() <= 20;
      }

      // Thông báo trong app: chỉ chủ hộ chiếu đọc, ghi.
      match /notifications/{notificationId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 120
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 400
          && request.resource.data.read is bool;
      }
    }

    match /reflections/{id} {
      allow read: if true;
      // Client không được tạo trường aiScore hay photoBase64; aiScore chỉ do Cloud Function (Admin SDK) ghi.
      allow create: if signedIn() && validReflectionCreate()
        && getAfter(/databases/$(database)/documents/reflection_owners/$(id)).data.uid == request.auth.uid;
      // Sửa: không được chạm vào aiScore hay photoBase64.
      allow update: if signedIn() && ownerOf(id) == request.auth.uid && validReflectionUpdate();
      allow delete: if signedIn() && ownerOf(id) == request.auth.uid;
    }

    match /reflection_owners/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid']);
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Dữ liệu rate limit nội bộ chỉ cho Cloud Functions (Admin SDK).
    match /_rate_limits/{docId} {
      allow read, write: if false;
    }
  }
}
