rules_version = '2';

// Quy tắc bảo mật Cloud Firestore cho Local Passport (thuần gói Spark):
// - Mỗi người chỉ đọc/ghi/xóa hộ chiếu của mình (`user_passports/{uid}`) theo schema chặt chẽ.
// - Ảnh lưu dạng Base64 nén nhỏ (`photoBase64` <= 120000 ký tự; `taskPhotos` list <= 3 phần tử)
//   và giữ tương thích ngược với `photoUrl` / `taskPhotoUrls` cũ.
// - `aiScore` là số nguyên 0..100; `reflection_owners/{id}` bất biến (`allow update: if false`).
// - `leaderboard_public/{uid}`: công khai đọc, chỉ chủ tài khoản tự ghi/xóa đúng schema.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwnerUid(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function ownerOf(id) {
      return get(/databases/$(database)/documents/reflection_owners/$(id)).data.uid;
    }

    function validPhotoUrl(v) {
      return v == null
        || (v is string && v.size() > 0 && v.size() <= 2048 && v.matches('^https?://.*'));
    }

    function validPhotoBase64(v) {
      return v == null || (v is string && v.size() <= 120000);
    }

    function validTaskPhotoItem(v) {
      return v is string && v.size() > 0 && v.size() <= 120000;
    }

    function validTaskPhotos(list) {
      return list is list
        && list.size() <= 3
        && (list.size() < 1 || validTaskPhotoItem(list[0]))
        && (list.size() < 2 || validTaskPhotoItem(list[1]))
        && (list.size() < 3 || validTaskPhotoItem(list[2]));
    }

    function validPassport(d) {
      return d.keys().hasOnly(['name', 'passportNo', 'joinedAt', 'xp', 'stampCount', 'avatarUrl'])
        && d.keys().hasAll(['name', 'passportNo', 'joinedAt', 'xp', 'stampCount'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && d.passportNo is string && d.passportNo.size() >= 3 && d.passportNo.size() <= 32
        && d.joinedAt is timestamp
        && d.xp is int && d.xp >= 0 && d.xp <= 1000000
        && d.stampCount is int && d.stampCount >= 0 && d.stampCount <= 500
        && validPhotoUrl(d.get('avatarUrl', null));
    }

    function validVisit(d) {
      return d.keys().hasOnly(['unlocked', 'unlockedAt', 'tasks', 'taskPhotos', 'taskPhotoUrls', 'stampedAt'])
        && d.keys().hasAll(['unlocked', 'tasks'])
        && d.unlocked is bool
        && (d.get('unlockedAt', null) == null || d.unlockedAt is timestamp)
        && (d.get('stampedAt', null) == null || d.stampedAt is timestamp)
        && d.tasks is list && d.tasks.size() <= 30
        && validTaskPhotos(d.get('taskPhotos', []))
        && d.get('taskPhotoUrls', {}) is map
        && d.get('taskPhotoUrls', {}).size() <= 3;
    }

    function validNotification(d) {
      return d.keys().hasOnly(['type', 'title', 'body', 'locationId', 'read', 'createdAt'])
        && d.keys().hasAll(['type', 'title', 'body', 'read', 'createdAt'])
        && d.type is string && d.type.size() >= 1 && d.type.size() <= 32
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 120
        && d.body is string && d.body.size() >= 1 && d.body.size() <= 400
        && (d.get('locationId', null) == null || (d.locationId is string && d.locationId.size() <= 80))
        && d.read is bool
        && d.createdAt is timestamp;
    }

    function validReflectionCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly(['locationId', 'displayAuthor', 'isAnonymous', 'content', 'aiScore', 'createdAt', 'photoBase64', 'photoUrl'])
        && d.keys().hasAll(['locationId', 'displayAuthor', 'isAnonymous', 'content', 'aiScore', 'createdAt'])
        && d.locationId is string && d.locationId.size() > 0 && d.locationId.size() <= 80
        && d.displayAuthor is string && d.displayAuthor.size() > 0 && d.displayAuthor.size() <= 80
        && d.isAnonymous is bool
        && d.content is string && d.content.size() > 0 && d.content.size() <= 2000
        && d.aiScore is int && d.aiScore >= 0 && d.aiScore <= 100
        && d.createdAt is timestamp
        && validPhotoBase64(d.get('photoBase64', null))
        && validPhotoUrl(d.get('photoUrl', null));
    }

    function validReflectionUpdate() {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return !changed.hasAny(['locationId', 'createdAt'])
        && changed.hasOnly(['displayAuthor', 'isAnonymous', 'content', 'aiScore', 'photoBase64', 'photoUrl', 'updatedAt'])
        && d.displayAuthor is string && d.displayAuthor.size() > 0 && d.displayAuthor.size() <= 80
        && d.isAnonymous is bool
        && d.content is string && d.content.size() > 0 && d.content.size() <= 2000
        && d.aiScore is int && d.aiScore >= 0 && d.aiScore <= 100
        && validPhotoBase64(d.get('photoBase64', null))
        && validPhotoUrl(d.get('photoUrl', null))
        && (d.get('updatedAt', null) == null || d.updatedAt is timestamp);
    }

    function validLeaderboardEntry(d) {
      return d.keys().hasOnly(['displayName', 'xp', 'stampCount', 'avatarUrl', 'updatedAt'])
        && d.keys().hasAll(['displayName', 'xp', 'stampCount', 'updatedAt'])
        && d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 40
        && d.xp is int && d.xp >= 0 && d.xp <= 50000
        && d.stampCount is int && d.stampCount >= 0 && d.stampCount <= 200
        && validPhotoUrl(d.get('avatarUrl', null))
        && d.updatedAt is timestamp;
    }

    match /user_passports/{uid} {
      allow read, delete: if isOwnerUid(uid);
      allow create, update: if isOwnerUid(uid) && validPassport(request.resource.data);

      match /visits/{locationId} {
        allow read, delete: if isOwnerUid(uid);
        allow create, update: if isOwnerUid(uid) && validVisit(request.resource.data);
      }

      // Thông báo trong app: chỉ chủ hộ chiếu đọc, ghi.
      match /notifications/{notificationId} {
        allow read, delete: if isOwnerUid(uid);
        allow create, update: if isOwnerUid(uid) && validNotification(request.resource.data);
      }
    }

    match /reflections/{id} {
      allow read: if true;
      // Kiến trúc Spark: client gửi aiScore (0..100) từ heuristic offline hoặc endpoint ngoài.
      allow create: if signedIn() && validReflectionCreate()
        && getAfter(/databases/$(database)/documents/reflection_owners/$(id)).data.uid == request.auth.uid;
      // Chủ bài viết được sửa nội dung, ảnh, ẩn danh và điểm chấm lại (0..100).
      allow update: if signedIn() && ownerOf(id) == request.auth.uid && validReflectionUpdate();
      allow delete: if signedIn() && ownerOf(id) == request.auth.uid;
    }

    match /reflection_owners/{id} {
      // `resource == null`: cho đọc document chưa tồn tại để client biết bài
      // mới chưa có chủ. Thiếu nó, lệnh đọc bị từ chối và cả lần đồng bộ hỏng.
      allow read: if signedIn()
        && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid']);
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Bảng xếp hạng công khai (kiến trúc Spark): mọi người đọc được,
    // chỉ chủ sở hữu (request.auth.uid == uid) được tạo/sửa/xóa bản ghi của mình.
    match /leaderboard_public/{uid} {
      allow read: if true;
      allow create, update: if isOwnerUid(uid) && validLeaderboardEntry(request.resource.data);
      allow delete: if isOwnerUid(uid);
    }
  }
}
