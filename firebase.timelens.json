{
  "hosting": {
    "site": "local-passport-timelens",
    "public": "build/timelens",
    "ignore": ["**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      {
        "source": "**/*.@(js|wasm|mjs|json)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.@(ttf|otf|woff2|svg|png|jpg)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "@(index.html|flutter_service_worker.js|flutter_bootstrap.js|version.json)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**",
        "headers": [{ "key": "Permissions-Policy", "value": "camera=(self), geolocation=(self), microphone=()" }]
      }
    ]
  }
}
